[Unit]
Description=Ferienplanung Backend (Node/Express)
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=ferienplaner
Group=ferienplaner
WorkingDirectory=/opt/ferienplaner/server
EnvironmentFile=/etc/ferienplaner/ferienplaner.env
ExecStart=/usr/bin/node /opt/ferienplaner/server/server.js
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ferienplaner
UMask=0077
Restart=on-failure
RestartSec=2
KillMode=mixed
TimeoutStopSec=10

StateDirectory=ferienplaner

[Install]
WantedBy=multi-user.target
